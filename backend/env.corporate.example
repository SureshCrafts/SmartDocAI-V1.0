# Corporate Environment Configuration Example
# Copy this file to .env and update with your corporate settings

# Server Configuration
PORT=5001
NODE_ENV=corporate

# Database Configuration - Choose one of the following options:

# Option 1: Local MongoDB
# MONGO_URI=mongodb://localhost:27017/smartdoc-ai

# Option 2: Corporate MongoDB Server
# MONGO_URI=mongodb://corporate-mongo.company.com:27017/smartdoc-ai

# Option 3: MongoDB with Authentication
# MONGO_URI=mongodb://username:password@corporate-mongo.company.com:27017/smartdoc-ai?authSource=admin

# Option 4: MongoDB Atlas (Cloud)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/smartdoc-ai?retryWrites=true&w=majority

# Option 5: MongoDB with SSL/TLS
# MONGO_URI=mongodb://username:password@corporate-mongo.company.com:27017/smartdoc-ai?ssl=true&authSource=admin

# MongoDB Connection Options (add to URI or set separately)
# MONGO_SSL=true
# MONGO_SSL_CA=/path/to/ca-certificate.pem
# MONGO_SSL_CERT=/path/to/client-certificate.pem
# MONGO_SSL_KEY=/path/to/client-key.pem
# MONGO_SSL_PASS=your-ssl-password
# MONGO_AUTH_SOURCE=admin
# MONGO_REPLICA_SET=your-replica-set-name
# MONGO_READ_PREFERENCE=primary

# JWT Configuration
JWT_SECRET=your-corporate-jwt-secret-key-change-this-in-production

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key

# Corporate Proxy Configuration (if needed)
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=http://proxy.company.com:8080
# NO_PROXY=localhost,127.0.0.1,.company.com

# CORS Configuration
# FRONTEND_URL=https://smartdoc.company.com
# FRONTEND_URL=http://localhost:3000

# Rate Limiting (adjust for corporate environment)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
# AUTH_RATE_LIMIT_MAX_REQUESTS=50

# File Upload Configuration
# MAX_FILE_SIZE=10485760
# UPLOAD_PATH=./uploads

# Logging Configuration
# LOG_LEVEL=info
# LOG_FILE=./logs/app.log

# Security Configuration
# SESSION_SECRET=your-session-secret
# COOKIE_SECURE=true
# COOKIE_HTTPONLY=true
# COOKIE_SAMESITE=strict

# Corporate Network Timeouts
# REQUEST_TIMEOUT=30000
# CONNECTION_TIMEOUT=30000
# SOCKET_TIMEOUT=30000 